# ===== Atelier Kyo Storefront — Environment Variables =====
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# ----- Shopify Storefront API -----
# Storefront domain, e.g. atelier-kyo-template.myshopify.com (no protocol)
SHOPIFY_STORE_DOMAIN=

# Storefront access token (NOT Admin API token).
# Generate via: Shopify admin -> Settings -> Apps and sales channels
#   -> Develop apps -> Create app -> Configure Storefront API scopes
#   (read_products, read_collections, read_inventory, read_content, read_customer_tags)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shared secret for Shopify -> /api/revalidate webhook signature.
# Any random high-entropy string (e.g. `openssl rand -hex 32`).
SHOPIFY_REVALIDATION_SECRET=

# Storefront API version, e.g. 2026-01
SHOPIFY_API_VERSION=2026-01

# ----- Supabase (customer mgmt, contact form, dashboard) -----
# Project URL: https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Treat as secret.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Vercel / runtime hints -----
# Override at deploy time. Defaults to "production" on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
